                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""Provides a scripting component.
    Inputs:
        x: The x script variable
        y: The y script variable
    Output:
        a: The a output variable"""

__author__ = "kunal"
__version__ = "2019.04.22"

import rhinoscriptsyntax as rs
import Rhino.Geometry as rg

rot = rg.Quaternion.Rotation(rs.WorldXYPlane(), x)

Q1 = rot.A
Q2 = rot.B
Q3 = rot.C
Q4 = rot.D

o = x.Origin
X = o.X
Y = o.Y
Z = o.Z

print X
#print rot.A
#print rot.B
#print rot.C
#print rot.D
</item>
